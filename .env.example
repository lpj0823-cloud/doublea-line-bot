# LINE Messaging API
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Google Cloud Project（參考用）
GOOGLE_PROJECT_NAME=
GOOGLE_PROJECT_NUMBER=
GOOGLE_PROJECT_ID=

# Google Calendar（用 auth_setup.py 產生，base64 編碼）
GOOGLE_TOKEN_JSON=
# 行事曆 ID：'primary' 表示授權帳號自己的主要行事曆（預設值）
CALENDAR_ID=primary

# Gemini API
GEMINI_API_KEY=

# 排程推播固定送到這個 ID（建議填「培正家」群組的 groupId，避免有人私訊時推播跑到私訊）
PUSH_CHAT_ID=
# 設成 false：07:00 早安摘要不附精選箴言
ENABLE_PROVERB_PUSH=true
# 選用推播（免費方案預設關閉；升級 LINE 中用量方案後再打開）
ENABLE_EVENING_PUSH=false
ENABLE_EVENT_REMINDER=false
# 資料永久保存：Railway 掛 Volume 到 /data 後設 DATA_DIR=/data
DATA_DIR=
# 「附近餐廳」搜尋中心（預設台北市文山區）
RESTAURANT_AREA=台北市文山區
RESTAURANT_LAT=24.9897
RESTAURANT_LON=121.5703
# 自我檢查網址 /selftest?token=... 用；不設定則停用
SELFTEST_TOKEN=
