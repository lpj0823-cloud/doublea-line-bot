# LINE Messaging API
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Google Cloud Project（參考用）
GOOGLE_PROJECT_NAME=
GOOGLE_PROJECT_NUMBER=
GOOGLE_PROJECT_ID=

# Google Calendar（用 auth_setup.py 產生，base64 編碼）
GOOGLE_TOKEN_JSON=
# 行事曆 ID：'primary' 表示授權帳號自己的主要行事曆（預設值）
CALENDAR_ID=primary

# Gemini API
GEMINI_API_KEY=

# 排程推播固定送到這個 ID（建議填「培正家」群組的 groupId，避免有人私訊時推播跑到私訊）
PUSH_CHAT_ID=
# 設成 false 可關閉每天 07:05 的箴言推播（省 LINE 推播額度）
ENABLE_PROVERB_PUSH=true
# 自我檢查網址 /selftest?token=... 用；不設定則停用
SELFTEST_TOKEN=
